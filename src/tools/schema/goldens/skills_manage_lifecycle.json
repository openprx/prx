  "properties": {
    "action": {
      "description": "Skill action: 'create' writes a new instruction skill, 'install' adds one from a source, 'update' refreshes an installed one, 'enable' and 'disable' toggle one, 'validate' checks one, 'sync' synchronizes the community skill repositories, 'remove' deletes one, 'lifecycle_status' reports the lifecycle mode and proposal counts, 'lifecycle_list' lists proposals, 'lifecycle_inspect' shows one proposal, 'lifecycle_publish' publishes an eligible proposal, 'lifecycle_cancel' closes a proposal, 'lifecycle_rollback' re-activates an earlier revision, 'lifecycle_import_executable' publishes a reviewed executable bundle",
      "enum": [
        "create",
        "install",
        "update",
        "enable",
        "disable",
        "validate",
        "sync",
        "remove",
        "lifecycle_status",
        "lifecycle_list",
        "lifecycle_inspect",
        "lifecycle_publish",
        "lifecycle_cancel",
        "lifecycle_rollback",
        "lifecycle_import_executable"
      ],
      "type": "string"
    },
    "description": {
      "description": "Short description of the skill; required for 'create'",
      "minLength": 1,
      "type": "string"
    },
    "expected_generation": {
      "description": "Active generation the caller observed; required for 'lifecycle_rollback'",
      "minimum": 0,
      "type": "integer"
    },
    "instructions": {
      "description": "SKILL.md instructions; required for 'create'",
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "description": "Workspace skill name; required for 'create', 'update', 'enable', 'disable', 'validate' and 'remove'",
      "minLength": 1,
      "type": "string"
    },
    "proposal_id": {
      "description": "Lifecycle proposal id; required for 'lifecycle_inspect', 'lifecycle_publish' and 'lifecycle_cancel'",
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "description": "Why the proposal is closed; optional for 'lifecycle_cancel'",
      "type": "string"
    },
    "revision_id": {
      "description": "An earlier published revision id, required for 'lifecycle_rollback'; for 'lifecycle_import_executable' the complete bundle hash the operator reviewed",
      "minLength": 1,
      "type": "string"
    },
    "skill_id": {
      "description": "Lifecycle skill id; optional filter for 'lifecycle_list', required for 'lifecycle_rollback'",
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "description": "Git URL or explicit local directory; required for 'install'. For 'lifecycle_import_executable', the directory of the reviewed executable bundle",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "action"
  ],
  "type": "object"
}
